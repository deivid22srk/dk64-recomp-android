diff --git a/src/shaders/FlatProbePS.hlsl b/src/shaders/FlatProbePS.hlsl
new file mode 100644
index 0000000..6b4bedb
--- /dev/null
+++ b/src/shaders/FlatProbePS.hlsl
@@ -0,0 +1,20 @@
+//
+// RT64 (port DK64-Recomp Android)
+//
+// Minimal pixel shader used by RasterShader::detectFlatShadingSupport to probe
+// whether the driver can link pipelines that carry a flat shaded varying.
+//
+// The COLOR1 input is declared with nointerpolation exactly like RasterPS.hlsl
+// does for the uber shader. Drivers that fail to link such pipelines (upstream
+// RT64 issue #183, Adreno 6xx proprietary) fail this pipeline too, which lets
+// the runtime fall back to stripping the Flat decorations from every raster
+// shader before the real pipeline creation is attempted.
+//
+
+void PSMain(
+      in float4 vertexPosition : SV_POSITION
+    , nointerpolation in float4 vertexFlatColor : COLOR1
+    , out float4 resultColor : SV_TARGET0)
+{
+    resultColor = vertexFlatColor;
+}
diff --git a/src/shaders/FlatProbeVS.hlsl b/src/shaders/FlatProbeVS.hlsl
new file mode 100644
index 0000000..5575dfb
--- /dev/null
+++ b/src/shaders/FlatProbeVS.hlsl
@@ -0,0 +1,23 @@
+//
+// RT64 (port DK64-Recomp Android)
+//
+// Minimal vertex shader used by RasterShader::detectFlatShadingSupport to probe
+// whether the driver can link pipelines that carry a flat shaded varying.
+//
+// The output COLOR1 is deliberately declared WITHOUT nointerpolation, exactly
+// like RasterVS.hlsl does for the uber shader, so the probe reproduces the
+// smooth-output/flat-input interface combination that the proprietary Adreno
+// 6xx drivers fail to link (upstream RT64 issue #183).
+//
+
+void VSMain(
+      in float4 iPosition : POSITION
+    , in float4 iColor : COLOR
+    , out float4 oPosition : SV_POSITION
+    , out float4 oSmoothColor : COLOR0
+    , out float4 oFlatColor : COLOR1)
+{
+    oPosition = iPosition;
+    oSmoothColor = iColor;
+    oFlatColor = iColor;
+}
