diff --git a/src/shaders/RasterPSSolidPS.hlsl b/src/shaders/RasterPSSolidPS.hlsl
new file mode 100644
index 0000000..8b5da3d
--- /dev/null
+++ b/src/shaders/RasterPSSolidPS.hlsl
@@ -0,0 +1,110 @@
+//
+// RT64 (port DK64-Recomp Android)
+//
+// Last-resort fallback permutation of the raster pixel shader (runtime "rung 3").
+// The proprietary Qualcomm drivers of the Adreno 6xx family deterministically fail
+// the compilation of some of the specialized raster pixel shaders, and the whole
+// pipeline creation with it, which used to leave entire geometry categories
+// unrendered (draws were skipped and the framebuffer stayed black behind them).
+//
+// This permutation carries none of the heavy machinery of RasterPS.hlsl: no
+// texture sampling, no buffers, no derivatives, no coverage math. It shades every
+// pixel with the interpolated vertex color (smooth or flat, picked from the
+// render flags spec constant), so geometry becomes visible with its vertex
+// shading even when every other permutation is rejected by the driver. It is
+// compiled as a single-output shader (the blend factor lives in output 0's alpha
+// channel, like the RASTER_PS_NO_DUAL_SOURCE permutations), which matches the
+// SRC_ALPHA blend state that the pipelines use when dual source blending is
+// considered unreliable.
+//
+// One piece of RasterPS.hlsl is deliberately kept even in this last resort: the
+// coplanar decal rejection. ZMODE_DEC pipelines are created WITHOUT a hardware
+// depth test (zCmp is false whenever zMode is ZMODE_DEC in RasterShader), so a
+// decal draw that ran through a permutation without the rejection check would
+// paint over everything drawn before it (observed as the ground path rendering
+// on top of trees when the SAFE rung lacked the check). The rejection only needs
+// a background depth texel load, which is derivative free and far simpler than
+// the texture sampling the dither shaders that already link on this driver
+// family perform.
+//
+// The input interface mirrors RasterPS.hlsl's PSMain (COLOR1 exists only when the
+// VERTEX_FLAT_COLOR permutation is built), so it can be swapped in for any
+// specialized shader without touching the vertex shader or the pipeline layout.
+// Deliberate deviation: COLOR1 is NOT declared with nointerpolation. The raster
+// vertex shaders emit COLOR1 without the Flat decoration (upstream behavior), so
+// a flat-decorated input would recreate the smooth-out/flat-in mismatch that the
+// proprietary Adreno drivers fail to link. Without the modifier the interface is
+// matched on every driver, and the flat color is uniform per primitive on N64
+// content anyway, so the smooth interpolation is visually indistinguishable.
+//
+
+#include "shared/rt64_render_params.h"
+#include "shared/rt64_render_flags.h"
+#include "shared/rt64_other_mode.h"
+#include "Depth.hlsli"
+#include "RenderParamsSpecConstants.hlsli"
+
+#if defined(MULTISAMPLING)
+Texture2DMS<float> gBackgroundDepth : register(t2, space3);
+
+float sampleBackgroundDepth(int2 pixelPos, uint sampleCount) {
+    float v = gBackgroundDepth.Load(pixelPos, 0);
+    if (sampleCount >= 2) {
+        v += gBackgroundDepth.Load(pixelPos, 1);
+    }
+
+    if (sampleCount >= 4) {
+        v += gBackgroundDepth.Load(pixelPos, 2);
+        v += gBackgroundDepth.Load(pixelPos, 3);
+    }
+
+    if (sampleCount >= 8) {
+        v += gBackgroundDepth.Load(pixelPos, 4);
+        v += gBackgroundDepth.Load(pixelPos, 5);
+        v += gBackgroundDepth.Load(pixelPos, 6);
+        v += gBackgroundDepth.Load(pixelPos, 7);
+    }
+
+    return v / float(sampleCount);
+}
+#else
+Texture2D<float> gBackgroundDepth : register(t2, space3);
+
+float sampleBackgroundDepth(int2 pixelPos, uint sampleCount) {
+    return gBackgroundDepth.Load(int3(pixelPos, 0));
+}
+#endif
+
+void PSMain(
+      in float4 vertexPosition : SV_POSITION
+    , in float2 vertexUV : TEXCOORD
+    , in float4 vertexSmoothColor : COLOR0
+#if defined(VERTEX_FLAT_COLOR)
+    , in float4 vertexFlatColor : COLOR1
+#endif
+    , [[vk::location(0)]] out float4 pixelColor : SV_TARGET0)
+{
+#if !defined(VERTEX_FLAT_COLOR)
+    float4 vertexFlatColor = 0.0f;
+#endif
+    const uint rpFlags = rpFlagsValue;
+    const float4 vertexColor = renderFlagSmoothShade(rpFlags) ? vertexSmoothColor : float4(vertexFlatColor.rgb, vertexSmoothColor.a);
+
+    // Port DK64-Recomp Android: coplanar decal rejection, kept derivative free.
+    // The constant slope tolerance matches the SAFE permutation of RasterPS.hlsl;
+    // the prim depth refinement is unavailable here because this permutation does
+    // not read instance buffers.
+    const OtherMode otherMode = { rpOtherModeL, rpOtherModeH };
+    if (otherMode.zMode() == ZMODE_DEC) {
+        int2 pixelPos = floor(vertexPosition.xy);
+        uint sampleCount = 1U << renderFlagSampleCount(rpFlags);
+        float surfaceDepth = sampleBackgroundDepth(pixelPos, sampleCount);
+        const float DepthTolerance = max(CoplanarDepthTolerance(surfaceDepth), 1.0f / 1024.0f);
+        const float pixelDepth = renderFlagNoN(rpFlags) ? max(vertexPosition.z, 0.0f) : vertexPosition.z;
+        if (abs(pixelDepth - surfaceDepth) > DepthTolerance) {
+            discard;
+        }
+    }
+
+    pixelColor = float4(vertexColor.rgb, vertexColor.a);
+}
