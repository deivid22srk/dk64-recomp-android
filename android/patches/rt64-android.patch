-add_subdirectory(src/tools/file_to_c)
+if (NOT ANDROID)
+    add_subdirectory(src/tools/file_to_c)
+else()
+    # Cross-compiling (e.g. Android/NDK): the tool must not be built for the target.
+    # The custom commands further below still run on the host and reference
+    # `file_to_c` by name in both COMMAND and DEPENDS, so expose the host-built
+    # binary as an imported executable to keep those references resolving.
+    # The parent project passes its location through the FILE_TO_C_EXE cache
+    # variable (falling back to a lookup in the host PATH).
+    if (FILE_TO_C_EXE)
+        set(RT64_HOST_FILE_TO_C "${FILE_TO_C_EXE}")
+    else()
+        find_program(RT64_HOST_FILE_TO_C NAMES file_to_c)
+    endif()
+    if (RT64_HOST_FILE_TO_C)
+        if (NOT TARGET file_to_c)
+            add_executable(file_to_c IMPORTED GLOBAL)
+            set_target_properties(file_to_c PROPERTIES IMPORTED_LOCATION "${RT64_HOST_FILE_TO_C}")
+        endif()
+    else()
+        message(WARNING "rt64: cross-build without a host 'file_to_c' (set FILE_TO_C_EXE or install it in the host PATH); the shader/file embedding build steps will fail.")
+    endif()
+endif()
 add_subdirectory(src/contrib/re-spirv)
-add_subdirectory(src/contrib/nativefiledialog-extended)
