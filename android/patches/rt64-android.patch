+        // guarantee, so every word is read through memcpy instead of a uint32_t pointer.
+        const uint8_t *bytes = static_cast<const uint8_t *>(pData);
+        const size_t wordCount = pSize / sizeof(uint32_t);
+        if ((pSize % sizeof(uint32_t)) != 0 || wordCount < 5) {
+            return false;
+        }
+
+        uint32_t magicNumber = 0;
+        std::memcpy(&magicNumber, bytes, sizeof(uint32_t));
+        if (magicNumber != SPIRV_MAGIC_NUMBER) {
+            return false;
+        }
+
+        outData.clear();
+        outData.reserve(pSize);
+
+        // Preserve the 5-word module header (magic, version, generator, bound, schema).
+        outData.insert(outData.end(), bytes, bytes + 5 * sizeof(uint32_t));
+
+        // Every word after the header belongs to a full instruction stream laid out as
+        // [wordCount<<16 | opcode][operands...]. Decorations are metadata and are never
+        // referenced by result IDs, so dropping whole OpDecorate instructions keeps the
+        // module structurally valid. Decoration 14 is Flat.
+        for (size_t wordIndex = 5; wordIndex < wordCount; ) {
+            uint32_t instruction = 0;
+            std::memcpy(&instruction, bytes + wordIndex * sizeof(uint32_t), sizeof(uint32_t));
+            const uint32_t instructionWordCount = instruction >> 16;
+            const uint16_t opcode = instruction & 0xFFFF;
+            if ((instructionWordCount == 0) || ((wordIndex + instructionWordCount) > wordCount)) {
+                outData.clear();
