+//
+// RT64 (port DK64-Recomp Android)
+//
+// Minimal vertex shader used by RasterShader::detectFlatShadingSupport to probe
+// whether the driver can link pipelines that carry a flat shaded varying.
+//
+// The output COLOR1 is deliberately declared WITHOUT nointerpolation, exactly
+// like RasterVS.hlsl does for the uber shader, so the probe reproduces the
+// smooth-output/flat-input interface combination that the proprietary Adreno
+// 6xx drivers fail to link (upstream RT64 issue #183).
+//
+
+void VSMain(
+      in float4 iPosition : POSITION
+    , in float4 iColor : COLOR
+    , out float4 oPosition : SV_POSITION
+    , out float4 oSmoothColor : COLOR0
+    , out float4 oFlatColor : COLOR1)
+{
+    oPosition = iPosition;
+    oSmoothColor = iColor;
+    oFlatColor = iColor;
+}
