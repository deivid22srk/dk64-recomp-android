     VulkanInterface::VulkanInterface() {
 #endif
+#if defined(__ANDROID__)
+        // Port DK64-Recomp Android: usa o driver Vulkan custom (Turnip via
+        // adrenotools) quando houver um instalado no app; volkInitializeCustom
+        // preenche a tabela do volk com o vkGetInstanceProcAddr do driver.
