+    /*
+     * Port fix: a versão anterior verificava apenas o estado do stream ANTES
+     * da escrita e devolvia true incondicionalmente — uma falha de I/O no
+     * meio da escrita (disco cheio, EIO, processamento morto pelo sistema)
+     * produzia um arquivo truncado/corrompido reportado como sucesso. No
+     * Android isso era fatal na prática: a ROM "armazenada" da 1ª execução
+     * passava no check da UI e quebrava mais tarde no início do jogo, sem
+     * nenhum diagnóstico. Agora: resultado da escrita + flush/close +
+     * verificação do tamanho persistido em disco.
+     */
     std::ofstream out_file{ path, std::ios::binary };
 
     if (!out_file.good()) {
         return false;
     }
 
-    out_file.write(reinterpret_cast<const char*>(data.data()), data.size());
+    if (!data.empty()) {
+        out_file.write(reinterpret_cast<const char*>(data.data()), data.size());
+        if (!out_file.good()) {
+            return false;
+        }
+    }
 
-    return true;
+    out_file.close();
+    if (!out_file.good()) {
+        return false;
+    }
+
+    // Verificação de persistência: um stat barato fecha a janela de
+    // truncamento silencioso (write "bem-sucedido" com dados perdidos no
+    // cache sem flush efetivo do sistema de arquivos).
+    std::error_code ec;
+    const auto written_size = std::filesystem::file_size(path, ec);
+    return !ec && written_size == data.size();
 }
 
